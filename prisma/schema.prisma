generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Contact {
  id          Int      @id @default(autoincrement())
  name        String
  phone       String
  email       String
  message     String?
  createdAt   DateTime @default(now())
  meetingDate String?
  meetingTime String?
  userType    String?
}

model TrialMeeting {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String
  userType  String
  message   String
  createdAt DateTime @default(now())
}

model User {
  id                  Int                    @id @default(autoincrement())
  name                String?
  email               String                 @unique
  password            String?
  role                String
  phone               String?
  isVerified          Boolean                @default(false)
  createdAt           DateTime               @default(now())
  emailVerified       Boolean                @default(false)
  phoneVerified       Boolean                @default(false)
  assignedCoachId     Int?
  grade               String?
  track               String?
  studentAppointments Appointment[]          @relation("StudentAppointments")
  carts               Cart[]
  coachProfile        Coach?                 @relation("CoachProfile")
  couponUsages        CouponUsage[]
  orders              Order[]
  passwordResetTokens PasswordResetToken[]
  paymentMetas        PaymentMeta[]
  rememberTokens      RememberToken[]
  lessonRequests      StudentLessonRequest[]
  reviewedProfiles    TeacherProfile[]       @relation("TeacherProfileReviewer")
  teacherProfile      TeacherProfile?        @relation("TeacherProfileUser")
  teacherReviews      TeacherReview[]        @relation("UserTeacherReviews")
  assignedCoach       Coach?                 @relation("AssignedCoach", fields: [assignedCoachId], references: [id])
  verificationCodes   VerificationCode[]
}

model Coach {
  id          Int    @id @default(autoincrement())
  name        String
  subject     String
  description String
  image       String
  userId      Int?   @unique
  user        User?  @relation("CoachProfile", fields: [userId], references: [id])
  assignedTo  User[] @relation("AssignedCoach")
}

model Order {
  id              Int                    @id @default(autoincrement())
  package         String
  createdAt       DateTime               @default(now())
  userId          Int
  billingInfoId   Int
  endDate         DateTime
  startDate       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  status          String                 @default("pending_payment")
  refundMessage   String?
  refundReason    String?
  merchantOid     String?                @unique
  totalPrice      Float?
  billingInfo     BillingInfo            @relation("BillingToOrder", fields: [billingInfoId], references: [id])
  user            User                   @relation(fields: [userId], references: [id])
  orderItems      OrderItem[]
  studentRequests StudentLessonRequest[] @relation("OrderStudentRequest")
}

model Package {
  id          Int    @id @default(autoincrement())
  name        String
  description String
  price       Float
}

model Cart {
  id           String     @id @default(cuid())
  userId       Int?
  email        String?
  status       CartStatus @default(OPEN)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  completed    Boolean    @default(false)
  reminderStep Int        @default(0)
  user         User?      @relation(fields: [userId], references: [id])
  items        CartItem[]
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  slug      String
  title     String
  unitPrice Int
  quantity  Int    @default(1)
  cart      Cart   @relation(fields: [cartId], references: [id])

  @@unique([cartId, slug])
}

model BillingInfo {
  id          Int     @id @default(autoincrement())
  email       String
  name        String
  surname     String
  address     String
  district    String
  city        String
  postalCode  String
  phone       String
  allowEmails Boolean
  tcNo        String?
  orders      Order[] @relation("BillingToOrder")
}

model OrderItem {
  id          Int     @id @default(autoincrement())
  name        String
  quantity    Int
  description String?
  orderId     Int
  price       Float
  order       Order   @relation(fields: [orderId], references: [id])
}

model Coupon {
  id             Int           @id @default(autoincrement())
  code           String        @unique
  discountRate   Int?          @default(0)
  usageLimit     Int
  createdAt      DateTime      @default(now())
  discountAmount Int?          @default(0)
  isFirstOrder   Boolean       @default(false)
  type           String        @default("RATE")
  validPackages  String[]      @default([])
  usedBy         CouponUsage[]
}

model CouponUsage {
  id       Int      @id @default(autoincrement())
  userId   Int
  couponId Int
  usedAt   DateTime @default(now())
  coupon   Coupon   @relation(fields: [couponId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([userId, couponId])
}

model VerificationCode {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String
  target    String
  code      String
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id])
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id])
}

model PaymentMeta {
  id           Int      @id @default(autoincrement())
  merchantOid  String   @unique
  userId       Int
  cart         Json
  billingInfo  Json
  packageName  String
  discountRate Int
  couponCode   String?
  totalPrice   Float
  createdAt    DateTime @default(now())
  requestId    String?  @db.VarChar(191)
  packageSlug  String?
  user         User     @relation(fields: [userId], references: [id])

  @@index([requestId])
}

model RememberToken {
  id         String   @id @default(cuid())
  userId     Int
  secretHash String
  userAgent  String?
  ip         String?
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  revoked    Boolean  @default(false)
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@index([revoked])
}

model TeacherProfile {
  id             String                 @id @default(cuid())
  userId         Int                    @unique
  firstName      String
  lastName       String
  subjects       String[]
  grades         String[]
  city           String
  district       String
  mode           LessonMode             @default(BOTH)
  priceOnline    Int?
  priceF2F       Int?
  bio            String?
  photoUrl       String?
  slug           String                 @unique
  isPublic       Boolean                @default(false)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  ratingAverage  Float                  @default(0)
  ratingCount    Int                    @default(0)
  viewCount      Int                    @default(0)
  timeZone       String?                @default("Europe/Istanbul")
  whyMe          String?
  publishStatus  PublishStatus          @default(DRAFT)
  reviewNote     String?
  reviewedAt     DateTime?
  reviewerId     Int?
  submittedAt    DateTime?
  appointments   Appointment[]
  lessonRequests StudentLessonRequest[]
  availabilities TeacherAvailability[]
  lessons        TeacherLesson[]
  reviewer       User?                  @relation("TeacherProfileReviewer", fields: [reviewerId], references: [id])
  user           User                   @relation("TeacherProfileUser", fields: [userId], references: [id], onDelete: Cascade)
  reviews        TeacherReview[]
  timeOffs       TeacherTimeOff[]

  @@index([city])
  @@index([district])
  @@index([mode])
  @@index([viewCount])
  @@index([ratingAverage])
  @@index([ratingCount])
  @@index([publishStatus])
}

model TeacherReview {
  id               String         @id @default(cuid())
  teacherProfileId String
  userId           Int?
  rating           Int
  comment          String?
  createdAt        DateTime       @default(now())
  appointmentId    String?        @unique
  appointment      Appointment?   @relation("AppointmentReviews", fields: [appointmentId], references: [id])
  teacher          TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  user             User?          @relation("UserTeacherReviews", fields: [userId], references: [id])

  @@index([teacherProfileId])
  @@index([rating])
  @@index([appointmentId])
}

model TeacherAvailability {
  id               String         @id @default(cuid())
  teacherProfileId String
  weekday          Int
  startMin         Int
  endMin           Int
  mode             LessonMode     @default(BOTH)
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  teacher          TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)

  @@index([teacherProfileId, weekday])
}

model TeacherTimeOff {
  id               String         @id @default(cuid())
  teacherProfileId String
  startsAt         DateTime
  endsAt           DateTime
  reason           String?
  createdAt        DateTime       @default(now())
  teacher          TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)

  @@index([teacherProfileId, startsAt, endsAt])
}

model Appointment {
  id               String            @id @default(cuid())
  teacherProfileId String
  studentUserId    Int?
  startsAt         DateTime
  endsAt           DateTime
  mode             LessonMode
  status           AppointmentStatus @default(PENDING)
  price            Int?
  title            String?
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  student          User?             @relation("StudentAppointments", fields: [studentUserId], references: [id])
  teacher          TeacherProfile    @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  reviews          TeacherReview?    @relation("AppointmentReviews")

  @@index([teacherProfileId, startsAt])
}

model TeacherLesson {
  id               String         @id @default(cuid())
  teacherProfileId String
  subject          String
  topic            String?
  durationMin      Int            @default(60)
  priceOnline      Int?
  priceF2F         Int?
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  teacher          TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)

  @@index([teacherProfileId])
  @@index([subject])
  @@index([topic])
}

model StudentLessonRequest {
  id               String         @id @default(cuid())
  studentId        Int
  teacherProfileId String
  subject          String
  grade            String
  mode             RequestMode
  city             String?
  district         String?
  locationNote     String?
  note             String?
  status           RequestStatus  @default(SUBMITTED)
  packageSlug      String?
  packageTitle     String?
  packageUnitPrice Int?
  orderId          Int?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  order            Order?         @relation("OrderStudentRequest", fields: [orderId], references: [id])
  student          User           @relation(fields: [studentId], references: [id])
  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id])

  @@index([studentId])
  @@index([teacherProfileId])
  @@index([status, createdAt])
  @@index([orderId])
}

model StudentPackageRight {
  id          String   @id @default(cuid())
  studentId   Int
  packageSlug String
  period      String
  rightsTotal Int
  rightsUsed  Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([studentId, packageSlug, period], name: "studentId_packageSlug_period")
}

enum CartStatus {
  OPEN
  ORDERED
  ABANDONED
}

enum LessonMode {
  ONLINE
  FACE_TO_FACE
  BOTH
}

enum PublishStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum RequestMode {
  ONLINE
  FACE_TO_FACE
}

enum RequestStatus {
  DRAFT
  SUBMITTED
  PACKAGE_SELECTED
  PAID
  CANCELLED
}

enum InstructorCategory {
  PDR_GRADUATE      // PDR Mezunu
  PDR_STUDENT       // PDR Öğrencisi
  UNIVERSITY_STUDENT // Üniversite Öğrencisi
}

model InstructorApplication {
  id          String              @id @default(cuid())
  firstName   String
  lastName    String
  email       String
  phone       String
  birthDate   DateTime?
  category    InstructorCategory
  university  String?
  department  String?
  ranking     String?             // YKS Derecesi
  message     String?             @db.Text
  cvUrl       String?             // Cloudinary URL
  status      String              @default("PENDING") // PENDING, REVIEWED, ACCEPTED, REJECTED
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
}