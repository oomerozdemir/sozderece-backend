generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Contact {
  id          Int      @id @default(autoincrement())
  name        String
  phone       String
  email       String
  message     String?
  createdAt   DateTime @default(now())
  meetingDate String?
  meetingTime String?
  userType    String?
}

model ConsultationSlot {
  id        Int      @id @default(autoincrement())
  date      String // "2026-03-20" formatında
  timeSlot  String // "09:00 - 09:20" formatında
  isBlocked Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, timeSlot])
}

// ── Öğrenci Paneli (Faz 1) ──────────────────────────────────────────────
model StudyPlan {
  id          Int             @id @default(autoincrement())
  studentId   Int
  student     User            @relation("StudentStudyPlans", fields: [studentId], references: [id])
  weekStart   DateTime // o haftanın pazartesi tarihi (çapa)
  title       String?
  createdById Int? // planı hazırlayan koç/admin User.id
  items       StudyPlanItem[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([studentId, weekStart])
}

model StudyPlanItem {
  id          Int       @id @default(autoincrement())
  studyPlanId Int
  studyPlan   StudyPlan @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)
  dayOfWeek   Int // 0=Pazartesi ... 6=Pazar
  subject     String
  topic       String? // nokta atışı görev detayı, ör. "3D Yayınları, Sayfa 45-52, 4 Test"
  durationMin Int?
  order       Int       @default(0)
  // "pending" | "done" | "partial" (Yarıda Kaldı) | "stuck" (Zorlandım) —
  // koça anlık geri bildirim vermek için tek tuşla "bitti" dışında da
  // işaretlenebilir bir durum sistemi.
  status      String    @default("pending")
  statusAt    DateTime?
  pomodoroSessions PomodoroSession[]
}

// Bir öğrencinin bir gününün otomatik özeti ("Z-Raporu") — o günün tüm
// görevleri bir sonuca bağlandığında (pending kalmadığında) otomatik
// oluşur. Veliye otomatik gönderim YOK (henüz veli iletişim bilgisi
// toplanmıyor) — şimdilik öğrenci panelinde ve koç panelinde görünür.
model DayReport {
  id                 Int      @id @default(autoincrement())
  studentId          Int
  student            User     @relation("StudentDayReports", fields: [studentId], references: [id])
  date               DateTime // o günün tarihi (saat 00:00'a normalize)
  totalTasks         Int
  doneTasks          Int
  partialTasks       Int
  stuckTasks         Int
  totalMinutes       Int // planlanan süre ("done" görevlerin durationMin toplamı)
  actualStudyMinutes Int      @default(0) // Pomodoro ile ölçülen GERÇEK çalışma süresi
  generatedAt        DateTime @default(now())

  @@unique([studentId, date])
}

// Bir Pomodoro turu (varsayılan 25dk odak). Öğrenci bir göreve "Başlat"
// dediğinde oluşur, durdurulunca/tamamlanınca kapanır. "Gerçek Çalışma
// Süresi" bu tablodan (planlanan durationMin'den DEĞİL) hesaplanıyor —
// öğrenci gerçekte ne kadar süre çalıştığını yansıtıyor.
model PomodoroSession {
  id              Int            @id @default(autoincrement())
  studentId       Int
  student         User           @relation("StudentPomodoroSessions", fields: [studentId], references: [id])
  studyPlanItemId Int?
  studyPlanItem   StudyPlanItem? @relation(fields: [studyPlanItemId], references: [id], onDelete: SetNull)
  startedAt       DateTime       @default(now())
  endedAt         DateTime?
  plannedSeconds  Int            @default(1500) // 25 dk
  actualSeconds   Int? // durdurulunca hesaplanır
  completed       Boolean        @default(false) // tam 25dk'yı doldurdu mu, erken mi durdu

  @@index([studentId, startedAt])
}

// "SOS" — öğrenci kriz anında tek tuşla koçuna anlık bildirim düşürür.
// WhatsApp'a paralel olarak burada da görünür kılınıyor ki koç uygulamayı
// açtığında (mesajı kaçırmış olsa bile) hemen görsün.
model SosAlert {
  id           Int       @id @default(autoincrement())
  studentId    Int
  student      User      @relation("StudentSosAlerts", fields: [studentId], references: [id])
  message      String?
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedById Int? // çözüldü işaretleyen koç/admin User.id

  @@index([studentId, createdAt])
  @@index([resolvedAt])
}

// "Konu Takip Ağacı" müfredat kataloğu — TYT/AYT/LGS konu başlıkları.
// Admin panelden düzenlenebilir; ilk seed standart müfredattan.
model Topic {
  id        Int              @id @default(autoincrement())
  subject   String // "Matematik", "Fizik", ...
  name      String // "Üslü Sayılar"
  track     String // "yks" | "lgs"
  examType  String? // "TYT" | "AYT" | null (LGS'de kullanılmaz)
  order     Int              @default(0)
  hidden    Boolean          @default(false)
  masteries TopicMastery[]

  @@index([track, subject])
}

// Bir öğrencinin bir konudaki ustalık seviyesi — "none" | "studied"
// (Çalıştım) | "practiced" (Test Çözdüm) | "mastered" (Branş Denemesinde
// Full). Öğrenci konuya tıkladıkça sırayla ilerler.
model TopicMastery {
  id        Int      @id @default(autoincrement())
  studentId Int
  student   User     @relation("StudentTopicMastery", fields: [studentId], references: [id])
  topicId   Int
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  stage     String   @default("none")
  updatedAt DateTime @updatedAt

  @@unique([studentId, topicId])
}

// Koçun öğrenciye bıraktığı günlük yazılı/sesli not — panelin en üstünde,
// her sekmede sabit görünür (psikolojik çapa: "abla/abim bugün de bana özel
// bir şey yazdı"). Tarihçe tutulur, öğrenciye en güncel olan gösterilir.
model CoachNote {
  id        Int      @id @default(autoincrement())
  studentId Int
  student   User     @relation("StudentCoachNotes", fields: [studentId], references: [id])
  coachId   Int // yazan koç/admin User.id
  type      String // "text" | "audio"
  text      String?  @db.Text
  audioUrl  String?
  createdAt DateTime @default(now())

  @@index([studentId, createdAt])
}

model ExamResult {
  id          Int      @id @default(autoincrement())
  studentId   Int
  student     User     @relation("StudentExamResults", fields: [studentId], references: [id])
  examDate    DateTime
  examName    String // "3D Yayınları TYT Deneme 4"
  examType    String // "TYT" | "AYT" | "LGS"
  subjectNets Json // [{subject:"Matematik", net:24.5, correct:28, wrong:7, wrongTopicIds:[12,45]}, ...]
  // wrongTopicIds opsiyonel — "Akıllı Deneme Analizi" tekrar eden konu
  // hatalarını tespit edebilsin diye (bkz. detectRecurringWeaknesses).
  totalNet    Float?
  ranking     Int?
  notes       String?
  enteredById Int? // girişi yapan koç/admin User.id
  createdAt   DateTime @default(now())

  @@index([studentId, examDate])
}

model Resource {
  id           Int      @id @default(autoincrement())
  title        String
  description  String?
  type         String // "video" | "pdf" | "link" | "document"
  url          String
  targetTrack  String? // "yks" | "lgs" | null=her ikisi
  targetGrade  String? // "9".."12" | "Mezun" | null=hepsi
  subject      String?
  displayOrder Int      @default(0)
  hidden       Boolean  @default(false)
  createdAt    DateTime @default(now())
  // "Kilit Açma" dinamiği — 0 ise herkese açık; >0 ise öğrenci en az bu
  // kadar günlük ateş serisine ulaşana kadar kilitli (gri + kilit ikonu)
  // gösterilir. Oyunlaştırma çapası: seriyi bozmamak için bir sebep daha.
  requiredStreak Int    @default(0)
}

model Announcement {
  id          Int       @id @default(autoincrement())
  title       String
  body        String    @db.Text
  targetTrack String?
  targetGrade String?
  publishedAt DateTime  @default(now())
  expiresAt   DateTime?
  hidden      Boolean   @default(false)
}

model User {
  id                  Int                    @id @default(autoincrement())
  name                String?
  email               String                 @unique
  password            String?
  role                String
  phone               String?
  isVerified          Boolean                @default(false)
  createdAt           DateTime               @default(now())
  emailVerified       Boolean                @default(false)
  phoneVerified       Boolean                @default(false)
  assignedCoachId     Int?
  grade               String?
  track               String?
  // Yeni öğrenci paneli (StudyPlan/ExamResult/Resource/Announcement) hazır
  // olana kadar bu bayrak açık olmayan hiçbir öğrenci yenisini göremez —
  // /student/dashboard aynı kalır, StudentDashboard.jsx bu alana göre
  // eski/yeni paneli seçer. Admin panelden aç/kapat edilebilir.
  panelBetaAccess     Boolean                @default(false)
  studyPlans          StudyPlan[]            @relation("StudentStudyPlans")
  examResults         ExamResult[]           @relation("StudentExamResults")
  dayReports          DayReport[]            @relation("StudentDayReports")
  pomodoroSessions    PomodoroSession[]      @relation("StudentPomodoroSessions")
  sosAlerts           SosAlert[]             @relation("StudentSosAlerts")
  topicMasteries      TopicMastery[]         @relation("StudentTopicMastery")
  coachNotes          CoachNote[]            @relation("StudentCoachNotes")
  studentAppointments Appointment[]          @relation("StudentAppointments")
  carts               Cart[]
  coachProfile        Coach?                 @relation("CoachProfile")
  couponUsages        CouponUsage[]
  orders              Order[]
  passwordResetTokens PasswordResetToken[]
  paymentMetas        PaymentMeta[]
  rememberTokens      RememberToken[]
  lessonRequests      StudentLessonRequest[]
  reviewedProfiles    TeacherProfile[]       @relation("TeacherProfileReviewer")
  teacherProfile      TeacherProfile?        @relation("TeacherProfileUser")
  teacherReviews      TeacherReview[]        @relation("UserTeacherReviews")
  assignedCoach       Coach?                 @relation("AssignedCoach", fields: [assignedCoachId], references: [id])
  verificationCodes   VerificationCode[]
  subscriptions       Subscription[]
  visitors            Visitor[]
}

// Anonim ziyaretçi kimliği — sd_visitor_id olarak client'ta (localStorage)
// üretilip taşınır, satın almadan önceki tüm ziyaretleri tek kimlik altında
// toplar. userId sadece bilinen bir hesaba bağlanırsa doldurulur (v1'de
// otomatik eşleme mantığı YOK, alan ileride kullanılmak üzere bırakıldı).
// Sayfa bazlı görüntülenme kaydı — ör. "/14-gunde-calisma-aliskanligi-kazan"
// gibi kampanya sayfalarının kaç kez / kaç tekil ziyaretçi tarafından
// görüntülendiğini admin panelde göstermek için. VisitorSession'daki
// landingPage sadece oturumun İLK sayfasını tutuyor — buradaki amaç ise
// belirli bir sayfanın toplam görüntülenmesini (oturum içinde nereden
// girilmiş olursa olsun) saymak.
model PageView {
  id        String   @id @default(cuid())
  path      String
  visitorId String?
  sessionId String?
  createdAt DateTime @default(now())

  @@index([path, createdAt])
}

// Çerez banner'ında verilen kararın kaydı — KVKK için kimin ne zaman ne
// seçtiğinin izini tutar (sadece localStorage'da kalması yeterli değil,
// bizim tarafımızda da görünür/denetlenebilir olması için).
model ConsentLog {
  id         String   @id @default(cuid())
  visitorId  String?
  sessionId  String?
  necessary  Boolean  @default(true)
  analytics  Boolean  @default(false)
  marketing  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model Visitor {
  id            String           @id @default(cuid())
  firstSeenAt   DateTime         @default(now())
  lastSeenAt    DateTime         @updatedAt
  userId        Int?
  user          User?            @relation(fields: [userId], references: [id])
  sessions      VisitorSession[]
  orders        Order[]
  paymentMetas  PaymentMeta[]
  subscriptions Subscription[]

  @@index([userId])
  @@index([lastSeenAt])
}

// Tek bir ziyaret/oturum — 30 dakika hareketsizlikten sonra yeni oturum
// sayılır (GA4 varsayılanıyla aynı sınır). channel, deviceType, os, browser
// sunucu tarafında (parseUserAgent.js / classifyChannel.js) hesaplanır.
model VisitorSession {
  id             String         @id @default(cuid())
  visitorId      String
  visitor        Visitor        @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  startedAt      DateTime       @default(now())
  lastActivityAt DateTime       @updatedAt
  referrer       String?
  referrerDomain String?
  landingPage    String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmTerm        String?
  utmContent     String?
  channel        String?
  deviceType     String?
  os             String?
  browser        String?
  userAgent      String?
  pageViewCount  Int            @default(1)
  orders         Order[]
  paymentMetas   PaymentMeta[]
  subscriptions  Subscription[]

  @@index([visitorId, startedAt])
}

model Coach {
  id          Int    @id @default(autoincrement())
  name        String
  subject     String
  description String
  image       String
  userId      Int?   @unique
  user        User?  @relation("CoachProfile", fields: [userId], references: [id])
  assignedTo  User[] @relation("AssignedCoach")
}

model Order {
  id               Int                    @id @default(autoincrement())
  package          String
  createdAt        DateTime               @default(now())
  userId           Int?
  billingInfoId    Int
  endDate          DateTime
  startDate        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  status           String                 @default("pending_payment")
  refundMessage    String?
  refundReason     String?
  failReason       String?
  merchantOid      String?                @unique
  totalPrice       Float?
  subscriptionId   Int?
  visitorId        String?
  visitorSessionId String?
  billingInfo      BillingInfo            @relation("BillingToOrder", fields: [billingInfoId], references: [id])
  user             User?                  @relation(fields: [userId], references: [id])
  subscription     Subscription?          @relation(fields: [subscriptionId], references: [id])
  visitor          Visitor?               @relation(fields: [visitorId], references: [id], onDelete: SetNull)
  visitorSession   VisitorSession?        @relation(fields: [visitorSessionId], references: [id], onDelete: SetNull)
  orderItems       OrderItem[]
  studentRequests  StudentLessonRequest[] @relation("OrderStudentRequest")
}

// Aylık otomatik ödeme (abonelik). PayTR'nin Direct API / Kart Saklama
// sistemiyle çalışır — utoken/ctoken PayTR'nin kendi kart-saklama servisinden
// dönen referans token'larıdır, ham kart bilgisi burada hiç tutulmaz.
model Subscription {
  id                Int                  @id @default(autoincrement())
  userId            Int
  packageSlug       String
  planLabel         String
  amount            Int // kuruş/ay
  status            String               @default("active") // "active" | "past_due" | "cancelled"
  utoken            String
  ctoken            String
  cardLast4         String?
  cardBrand         String?
  currentPeriodEnd  DateTime
  nextBillingDate   DateTime
  cancelAtPeriodEnd Boolean              @default(false)
  cancelledAt       DateTime?
  failedAttempts    Int                  @default(0)
  lastFailureReason String?
  // Chargeback/itiraz savunması için rıza kanıt izi: kayıt anındaki IP,
  // zaman damgası ve kullanıcının onayladığı tam metin.
  consentIp         String?
  consentAt         DateTime?
  consentText       String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  visitorId         String?
  visitorSessionId  String?
  user              User                 @relation(fields: [userId], references: [id])
  visitor           Visitor?             @relation(fields: [visitorId], references: [id], onDelete: SetNull)
  visitorSession    VisitorSession?      @relation(fields: [visitorSessionId], references: [id], onDelete: SetNull)
  charges           SubscriptionCharge[]
  orders            Order[]

  @@index([userId])
  @@index([status, nextBillingDate])
}

model SubscriptionCharge {
  id             Int          @id @default(autoincrement())
  subscriptionId Int
  merchantOid    String       @unique
  amount         Int
  status         String // "success" | "failed"
  failReason     String?
  attemptNumber  Int          @default(1)
  attemptedAt    DateTime     @default(now())
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([subscriptionId])
}

model Package {
  id               Int       @id @default(autoincrement())
  slug             String    @unique
  name             String
  description      String
  price            Float
  unitPrice        Int?
  priceText        String?
  oldPriceText     String?
  subtitle         String?
  type             String?
  hidden           Boolean   @default(false)
  displayOrder     Int       @default(0)
  ctaLabel         String?
  ctaHref          String?
  features         Json      @default("[]")
  note             String?
  freeLessons      Int?
  promoPrice       Float?
  promoUnitPrice   Int?
  promoEndDate     DateTime?
  promoLabel       String?
  examDate         DateTime?
  examDiscountRate Float?
  plans            Json      @default("[]")
  // Sekmeli süre planı (plans[]) YOKSA paketin kendisinin tek seferlik mi
  // yoksa aylık abonelik mi olduğunu belirler — "once" | "monthly".
  billingCycle     String    @default("once")
  // Çoklu paket-kartı vitrininde (PricingSection) kartın üstünde gösterilen
  // öne-çıkarma rozeti, ör. "👍 En Popüler". Boşsa rozet gösterilmez.
  badge            String?
  // Kart içine gömülen, pakete özel tanıtım videosu (YouTube). Boşsa
  // kart üstünde video gösterilmez.
  videoUrl         String?
  // Ödeme sayfasındaki (CoachingWizardOdeme) güvence kutusu için paket bazlı
  // metin — boşsa sitedeki genel varsayılan metin (/api/settings/payment-page)
  // kullanılır. noRefund true ise bu metin yeşil "güvence" kutusu yerine
  // nötr bir "iade yok" bilgilendirmesi olarak gösterilir (ör. 14 Günlük
  // Program gibi tek seferlik/dijital içerik paketlerinde).
  guaranteeText    String?
  noRefund         Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Cart {
  id           String     @id @default(cuid())
  userId       Int?
  email        String?
  status       CartStatus @default(OPEN)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  completed    Boolean    @default(false)
  reminderStep Int        @default(0)
  user         User?      @relation(fields: [userId], references: [id])
  items        CartItem[]
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  slug      String
  title     String
  unitPrice Int
  quantity  Int    @default(1)
  cart      Cart   @relation(fields: [cartId], references: [id])

  @@unique([cartId, slug])
}

model BillingInfo {
  id          Int     @id @default(autoincrement())
  email       String
  name        String
  surname     String
  address     String
  district    String
  city        String
  postalCode  String
  phone       String
  allowEmails Boolean
  tcNo        String?
  sinif       String?
  alan        String?
  orders      Order[] @relation("BillingToOrder")
}

model OrderItem {
  id          Int     @id @default(autoincrement())
  name        String
  quantity    Int
  description String?
  orderId     Int
  price       Float
  order       Order   @relation(fields: [orderId], references: [id])
}

model Coupon {
  id             Int           @id @default(autoincrement())
  code           String        @unique
  discountRate   Int?          @default(0)
  usageLimit     Int
  createdAt      DateTime      @default(now())
  discountAmount Int?          @default(0)
  isFirstOrder   Boolean       @default(false)
  type           String        @default("RATE")
  validPackages  String[]      @default([])
  expiresAt      DateTime?
  usedBy         CouponUsage[]
}

model CouponUsage {
  id       Int      @id @default(autoincrement())
  userId   Int
  couponId Int
  usedAt   DateTime @default(now())
  coupon   Coupon   @relation(fields: [couponId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([userId, couponId])
}

model VerificationCode {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String
  target    String
  code      String
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id])
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id])
}

model PaymentMeta {
  id               Int             @id @default(autoincrement())
  merchantOid      String          @unique
  userId           Int?
  cart             Json
  billingInfo      Json
  packageName      String
  discountRate     Int
  couponCode       String?
  totalPrice       Float
  createdAt        DateTime        @default(now())
  requestId        String?         @db.VarChar(191)
  packageSlug      String?
  visitorId        String?
  visitorSessionId String?
  user             User?           @relation(fields: [userId], references: [id])
  visitor          Visitor?        @relation(fields: [visitorId], references: [id], onDelete: SetNull)
  visitorSession   VisitorSession? @relation(fields: [visitorSessionId], references: [id], onDelete: SetNull)

  @@index([requestId])
}

model RememberToken {
  id         String   @id @default(cuid())
  userId     Int
  secretHash String
  userAgent  String?
  ip         String?
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  revoked    Boolean  @default(false)
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@index([revoked])
}

model TeacherProfile {
  id             String                 @id @default(cuid())
  userId         Int                    @unique
  firstName      String
  lastName       String
  subjects       String[]
  grades         String[]
  city           String
  district       String
  mode           LessonMode             @default(BOTH)
  priceOnline    Int?
  priceF2F       Int?
  bio            String?
  photoUrl       String?
  slug           String                 @unique
  isPublic       Boolean                @default(false)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  ratingAverage  Float                  @default(0)
  ratingCount    Int                    @default(0)
  viewCount      Int                    @default(0)
  timeZone       String?                @default("Europe/Istanbul")
  whyMe          String?
  publishStatus  PublishStatus          @default(DRAFT)
  reviewNote     String?
  reviewedAt     DateTime?
  reviewerId     Int?
  submittedAt    DateTime?
  appointments   Appointment[]
  lessonRequests StudentLessonRequest[]
  availabilities TeacherAvailability[]
  lessons        TeacherLesson[]
  reviewer       User?                  @relation("TeacherProfileReviewer", fields: [reviewerId], references: [id])
  user           User                   @relation("TeacherProfileUser", fields: [userId], references: [id], onDelete: Cascade)
  reviews        TeacherReview[]
  timeOffs       TeacherTimeOff[]

  @@index([city])
  @@index([district])
  @@index([mode])
  @@index([viewCount])
  @@index([ratingAverage])
  @@index([ratingCount])
  @@index([publishStatus])
}

model TeacherReview {
  id               String         @id @default(cuid())
  teacherProfileId String
  userId           Int?
  rating           Int
  comment          String?
  createdAt        DateTime       @default(now())
  appointmentId    String?        @unique
  appointment      Appointment?   @relation("AppointmentReviews", fields: [appointmentId], references: [id])
  teacher          TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  user             User?          @relation("UserTeacherReviews", fields: [userId], references: [id])

  @@index([teacherProfileId])
  @@index([rating])
  @@index([appointmentId])
}

model TeacherAvailability {
  id               String         @id @default(cuid())
  teacherProfileId String
  weekday          Int
  startMin         Int
  endMin           Int
  mode             LessonMode     @default(BOTH)
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  teacher          TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)

  @@index([teacherProfileId, weekday])
}

model TeacherTimeOff {
  id               String         @id @default(cuid())
  teacherProfileId String
  startsAt         DateTime
  endsAt           DateTime
  reason           String?
  createdAt        DateTime       @default(now())
  teacher          TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)

  @@index([teacherProfileId, startsAt, endsAt])
}

model Appointment {
  id               String            @id @default(cuid())
  teacherProfileId String
  studentUserId    Int?
  startsAt         DateTime
  endsAt           DateTime
  mode             LessonMode
  status           AppointmentStatus @default(PENDING)
  price            Int?
  title            String?
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  student          User?             @relation("StudentAppointments", fields: [studentUserId], references: [id])
  teacher          TeacherProfile    @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  reviews          TeacherReview?    @relation("AppointmentReviews")

  @@index([teacherProfileId, startsAt])
}

model TeacherLesson {
  id               String         @id @default(cuid())
  teacherProfileId String
  subject          String
  topic            String?
  durationMin      Int            @default(60)
  priceOnline      Int?
  priceF2F         Int?
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  teacher          TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)

  @@index([teacherProfileId])
  @@index([subject])
  @@index([topic])
}

model StudentLessonRequest {
  id               String         @id @default(cuid())
  studentId        Int
  teacherProfileId String
  subject          String
  grade            String
  mode             RequestMode
  city             String?
  district         String?
  locationNote     String?
  note             String?
  status           RequestStatus  @default(SUBMITTED)
  packageSlug      String?
  packageTitle     String?
  packageUnitPrice Int?
  orderId          Int?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  order            Order?         @relation("OrderStudentRequest", fields: [orderId], references: [id])
  student          User           @relation(fields: [studentId], references: [id])
  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id])

  @@index([studentId])
  @@index([teacherProfileId])
  @@index([status, createdAt])
  @@index([orderId])
}

model StudentPackageRight {
  id          String   @id @default(cuid())
  studentId   Int
  packageSlug String
  period      String
  rightsTotal Int
  rightsUsed  Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([studentId, packageSlug, period], name: "studentId_packageSlug_period")
}

enum CartStatus {
  OPEN
  ORDERED
  ABANDONED
}

enum LessonMode {
  ONLINE
  FACE_TO_FACE
  BOTH
}

enum PublishStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum RequestMode {
  ONLINE
  FACE_TO_FACE
}

enum RequestStatus {
  DRAFT
  SUBMITTED
  PACKAGE_SELECTED
  PAID
  CANCELLED
}

enum InstructorCategory {
  PDR_GRADUATE // PDR Mezunu
  PDR_STUDENT // PDR Öğrencisi
  UNIVERSITY_STUDENT // Üniversite Öğrencisi
}

model InstructorApplication {
  id         String             @id @default(cuid())
  firstName  String
  lastName   String
  email      String
  phone      String
  birthDate  DateTime?
  category   InstructorCategory
  university String?
  department String?
  ranking    String? // YKS Derecesi
  experience String?            @db.Text // Koçluk / öğrenci takibi deneyimi
  samplePrograms String?        @db.Text // Yüklenen örnek program dosyalarının URL listesi (JSON dizi)
  message    String?            @db.Text
  cvUrl      String? // Cloudinary URL
  status     String             @default("PENDING") // PENDING, REVIEWED, ACCEPTED, REJECTED
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model SiteSettings {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model CampPage {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model CampApplication {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  phone     String
  email     String
  grade     String
  type      String   @default("free")
  status    String   @default("new")
  createdAt DateTime @default(now())
}

model LgsApplication {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  grade     String
  message   String?
  type      String   @default("call")
  status    String   @default("new")
  createdAt DateTime @default(now())
}

model YksApplication {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  grade     String
  message   String?
  type      String   @default("call")
  status    String   @default("new")
  createdAt DateTime @default(now())
}

model NavbarItem {
  id         Int      @id @default(autoincrement())
  name       String
  path       String
  visible    Boolean  @default(true)
  order      Int      @default(0)
  isExternal Boolean  @default(false)
  openInNew  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
