generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Contact {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  email     String
  message   String
  createdAt DateTime @default(now())
}

model TrialMeeting {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String
  userType  String // Öğrenci veya Veli
  message   String
  createdAt DateTime @default(now())
}

model User {
  id                  Int                  @id @default(autoincrement())
  name                String?
  email               String               @unique
  password            String?
  role                String
  phone               String?
  isVerified          Boolean              @default(false)
  createdAt           DateTime             @default(now())
  emailVerified       Boolean              @default(false)
  phoneVerified       Boolean              @default(false)
  assignedCoachId     Int?
  grade               String?
  track               String?
  coachProfile        Coach?               @relation("CoachProfile")
  couponUsages        CouponUsage[]
  orders              Order[]
  assignedCoach       Coach?               @relation("AssignedCoach", fields: [assignedCoachId], references: [id])
  verificationCodes   VerificationCode[]
  passwordResetTokens PasswordResetToken[]
  paymentMetas        PaymentMeta[]
  carts               Cart[]
  rememberTokens      RememberToken[]

  teacherProfile      TeacherProfile?      @relation("TeacherProfileUser")
  teacherReviews      TeacherReview[]      @relation("UserTeacherReviews")

  reviewedProfiles    TeacherProfile[]     @relation("TeacherProfileReviewer")

  studentAppointments Appointment[] @relation("StudentAppointments")
  lessonRequests      StudentLessonRequest[]
}

model Coach {
  id          Int    @id @default(autoincrement())
  name        String
  subject     String
  description String
  image       String
  userId      Int?   @unique
  user        User?  @relation("CoachProfile", fields: [userId], references: [id])
  assignedTo  User[] @relation("AssignedCoach")
}

model Order {
  id            Int         @id @default(autoincrement())
  package       String
  createdAt     DateTime    @default(now())
  userId        Int
  billingInfoId Int
  endDate       DateTime
  startDate     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  status        String      @default("pending_payment")
  refundMessage String?
  refundReason  String?
  merchantOid   String?     @unique
  totalPrice    Float?

  billingInfo   BillingInfo @relation("BillingToOrder", fields: [billingInfoId], references: [id])
  user          User        @relation(fields: [userId], references: [id])
  orderItems    OrderItem[]

  // 🔁 1→N: bir order birden çok talep
  studentRequests StudentLessonRequest[] @relation("OrderStudentRequest")
}

model Package {
  id          Int    @id @default(autoincrement())
  name        String
  description String
  price       Float
}

model Cart {
  id        String     @id @default(cuid())
  userId    Int? // Int? çünkü User.id Int
  user      User?      @relation(fields: [userId], references: [id])
  email     String?
  status    CartStatus @default(OPEN)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]
  completed Boolean     @default(false) // ödeme tamamlandı mı?
  reminderStep   Int         @default(0) // 0 = hiç mail atılmadı, 1 = ilk mail, 2 = ikinci mail...

}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  cart      Cart   @relation(fields: [cartId], references: [id])
  slug      String
  title     String
  unitPrice Int
  quantity  Int    @default(1)

  @@unique([cartId, slug])
}

enum CartStatus {
  OPEN
  ORDERED
  ABANDONED
}

model BillingInfo {
  id          Int     @id @default(autoincrement())
  email       String
  name        String
  surname     String
  address     String
  district    String
  city        String
  postalCode  String
  phone       String
  allowEmails Boolean
  tcNo        String?
  orders      Order[] @relation("BillingToOrder")
}

model OrderItem {
  id          Int     @id @default(autoincrement())
  name        String
  price       Float
  quantity    Int
  description String?
  orderId     Int
  order       Order   @relation(fields: [orderId], references: [id])
}

model Coupon {
  id           Int           @id @default(autoincrement())
  code         String        @unique
  discountRate Int
  usageLimit   Int
  createdAt    DateTime      @default(now())
  usedBy       CouponUsage[]
}

model CouponUsage {
  id       Int      @id @default(autoincrement())
  userId   Int
  couponId Int
  usedAt   DateTime @default(now())
  coupon   Coupon   @relation(fields: [couponId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([userId, couponId])
}

model VerificationCode {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  type      String // "email" veya "phone"
  target    String // gönderilecek adres/numara
  code      String
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model PaymentMeta {
  id           Int      @id @default(autoincrement())
  merchantOid  String   @unique
  userId       Int
  cart         Json
  billingInfo  Json
  packageName  String
  discountRate Int
  couponCode   String?
  totalPrice   Float
  createdAt    DateTime @default(now())
  packageSlug  String?

  requestId    String?  @db.VarChar(191) // StudentLessonRequest.id (cuid) saklanacak
  @@index([requestId])
  user User @relation(fields: [userId], references: [id])
  
}

model RememberToken {
  // Cookie formatı: "<id>.<secret>"
  // id -> bu modelin id'si (cuid), secret -> bcrypt hash'lenip DB'de secretHash olarak saklanır
  id         String   @id @default(cuid())
  userId     Int
  user       User     @relation(fields: [userId], references: [id])

  secretHash String   // raw secret'in bcrypt hash'i
  userAgent  String?
  ip         String?

  createdAt  DateTime @default(now())
  expiresAt  DateTime
  revoked    Boolean  @default(false)

  @@index([userId])
  @@index([expiresAt])
  @@index([revoked])
}

enum LessonMode {
  ONLINE
  FACE_TO_FACE
  BOTH
}

enum PublishStatus {
  DRAFT      // henüz talep yok
  PENDING    // admin onayında
  APPROVED   // onaylandı (yayında)
  REJECTED   // reddedildi
}

model TeacherProfile {
  id            String          @id @default(cuid())
  userId        Int             @unique
  user          User            @relation("TeacherProfileUser", fields: [userId], references: [id], onDelete: Cascade)

  firstName     String
  lastName      String
  subjects      String[]
  grades        String[]
  city          String
  district      String
  mode          LessonMode      @default(BOTH)
  priceOnline   Int?
  priceF2F      Int?
  bio           String?
  whyMe         String?
  photoUrl      String?
  slug          String          @unique

  // Yayın kontrolü
  isPublic      Boolean         @default(false)            // sadece APPROVED olduğunda true yapılır
  publishStatus PublishStatus   @default(DRAFT)
  submittedAt   DateTime?
  reviewedAt    DateTime?
  reviewerId    Int?
  reviewNote    String?
  reviewer      User?         @relation("TeacherProfileReviewer", fields: [reviewerId], references: [id])

  // Metrikler
  viewCount     Int             @default(0)
  ratingAverage Float           @default(0)
  ratingCount   Int             @default(0)
  reviews       TeacherReview[]

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  timeZone      String?         @default("Europe/Istanbul")

  // İlişkiler
  availabilities  TeacherAvailability[]
  timeOffs        TeacherTimeOff[]
  appointments    Appointment[]
  lessons         TeacherLesson[]
  lessonRequests  StudentLessonRequest[]

  @@index([city])
  @@index([district])
  @@index([mode])
  @@index([viewCount])
  @@index([ratingAverage])
  @@index([ratingCount])
  @@index([publishStatus])
}

model TeacherReview {
  id               String         @id @default(cuid())
  teacherProfileId String
  teacher          TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)

  userId           Int?
  user             User?          @relation("UserTeacherReviews", fields: [userId], references: [id], onDelete: SetNull)

  rating           Int            // 1..5
  comment          String?
  createdAt        DateTime       @default(now())

  appointmentId    String?

  appointment      Appointment?   @relation("AppointmentReviews", fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([teacherProfileId])
  @@index([rating])
  @@index([appointmentId])
  @@unique([appointmentId]) // ✅ Her randevuya en fazla 1 yorum
}


// Appointment Schema

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

// --- Haftalık uygunluk pencereleri (bir günde 0..n aralık) ---
model TeacherAvailability {
  id               String         @id @default(cuid())
  teacherProfileId String
  teacher          TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)

  // 0=Sun, 1=Mon ... 6=Sat (date-fns standardına uyduk)
  weekday          Int
  startMin         Int            // gün başından dakika (örn 9*60=540)
  endMin           Int            // (örn 17*60=1020)
  mode             LessonMode     @default(BOTH)
  isActive         Boolean        @default(true)

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([teacherProfileId, weekday])
}


// --- Öğretmenin tatil/blokajları (tekil tarih aralıkları) ---
model TeacherTimeOff {
  id               String         @id @default(cuid())
  teacherProfileId String
  teacher          TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)

  startsAt         DateTime       // UTC
  endsAt           DateTime       // UTC
  reason           String?

  createdAt        DateTime       @default(now())

  @@index([teacherProfileId, startsAt, endsAt])
}


// --- Randevu ---
model Appointment {
  id               String          @id @default(cuid())
  teacherProfileId String
  teacher          TeacherProfile  @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)

  studentUserId    Int?
  student          User?           @relation(name: "StudentAppointments", fields: [studentUserId], references: [id], onDelete: SetNull)


  startsAt         DateTime        // UTC
  endsAt           DateTime        // UTC
  mode             LessonMode
  status           AppointmentStatus @default(PENDING)
  price            Int?
  title            String?
  notes            String?

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  reviews          TeacherReview[] @relation("AppointmentReviews")

  @@index([teacherProfileId, startsAt])
}


model TeacherLesson {
  id               String         @id @default(cuid())
  teacherProfileId String
  teacher          TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)

  // Görünüm: “Matematik > Genel Matematik”
  subject   String                // Ana ders (Matematik)
  topic     String?               // Alt başlık (Genel Matematik) - opsiyonel
  durationMin Int                 @default(60)

  priceOnline Int?
  priceF2F   Int?

  isActive   Boolean              @default(true)

  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([teacherProfileId])
  @@index([subject])
  @@index([topic])
}


model StudentLessonRequest {
  id               String   @id @default(cuid())
  studentId        Int
  student          User     @relation(fields: [studentId], references: [id])
  teacherProfileId String
  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id])

  subject          String
  grade            String
  mode             RequestMode
  city             String?
  district         String?
  locationNote     String?
  note             String?

  status           RequestStatus @default(SUBMITTED)

  packageSlug      String?
  packageTitle     String?
  packageUnitPrice Int?

  orderId          Int?
  order            Order?   @relation("OrderStudentRequest", fields: [orderId], references: [id], onDelete: SetNull)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([studentId])
  @@index([teacherProfileId])
  @@index([status, createdAt])
  @@index([orderId]) // sorgu performansı için iyi olur
}
enum RequestMode {
  ONLINE
  FACE_TO_FACE
}

enum RequestStatus {
  DRAFT
  SUBMITTED
  PACKAGE_SELECTED
  PAID
  CANCELLED
}

model StudentPackageRight {
  id           String   @id @default(cuid())
  studentId    Int
  packageSlug  String
  period       String   // "once" | "monthly"
  rightsTotal  Int
  rightsUsed   Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([studentId, packageSlug, period], name: "studentId_packageSlug_period")
}