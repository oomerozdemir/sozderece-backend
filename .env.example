# PostgreSQL veritabanı bağlantı örneği
DATABASE_URL="postgresql://username:password@host:port/dbname?schema=public"

# JWT anahtarı örneği
JWT_SECRET=your_jwt_secret_key

# Koç panelinde haftalık program görselini/PDF'ini okumak için (console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_WORKSPACE_ID=your_workspace_id
# Opsiyonel — belirtilmezse "claude-sonnet-5" kullanılır
ANTHROPIC_PROGRAM_READER_MODEL=claude-sonnet-5
